# ==============================================================================
# Arcanfractal Environment Variables Example
# Copy this file to .env.local and fill in the values
# ==============================================================================

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# KKU IntelliShare API (Primary Provider - OpenAI Compatible)
KKU_INTELLISHARE_API_KEY=your_kku_intellishare_api_key_here
KKU_INTELLISHARE_BASE_URL=https://intellishare.kku.ac.th/v1
KKU_INTELLISHARE_MODEL=gpt-4o-mini

# Google Gemini API (Backup Provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Rate Limiting (Optional)
RATE_LIMIT_MAX_REQUESTS_PER_MINUTE=20
