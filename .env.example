# ==============================================================================
# Arcanfractal Environment Variables Example
# Copy this file to .env.local and fill in the values
# ==============================================================================

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# KKU IntelSphere API (Primary Provider - OpenAI Compatible)
# Inspect live available models at: https://gen.ai.kku.ac.th/api/v1/models
KKU_INTELSPHERE_API_KEY=your_kku_intelsphere_api_key_here
KKU_INTELSPHERE_BASE_URL=https://gen.ai.kku.ac.th/api/v1
# Options include: gemini-3.7-flash, deepseek-v4-flash, claude-sonnet-5, qwen3.6-flash, etc.
KKU_INTELSPHERE_MODEL=gemini-3.8-flash
# Note: KKU_INTELLISHARE_* environment variable names remain supported for backward compatibility.

# Google Gemini API (Backup Provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Rate Limiting (Optional)
RATE_LIMIT_MAX_REQUESTS_PER_MINUTE=20
